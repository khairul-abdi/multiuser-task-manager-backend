        {
          "name": "Generate Unique Test Data",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/health"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const suffix = Date.now() + '-' + Math.floor(Math.random() * 100000);",
                  "pm.collectionVariables.set('suffix', suffix);",
                  "pm.collectionVariables.set('user_email', `user.${suffix}@example.com`);",
                  "pm.collectionVariables.set('assignee_email', `assignee.${suffix}@example.com`);",
                  "pm.collectionVariables.set('outsider_email', `outsider.${suffix}@example.com`);",
                  "pm.collectionVariables.set('team_id', '101');",
                  "pm.collectionVariables.set('other_team_id', '202');",
                  "pm.collectionVariables.set('task_id', '');",
                  "pm.collectionVariables.set('token', '');",
                  "pm.collectionVariables.set('assignee_token', '');",
                  "pm.collectionVariables.set('outsider_token', '');",
                  "pm.collectionVariables.set('idempotency_key', crypto.randomUUID());",
                  "pm.collectionVariables.set('second_idempotency_key', crypto.randomUUID());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.expect([200]).to.include(pm.response.code); });",
                  "pm.test('test data generated', function () { pm.expect(pm.collectionVariables.get('user_email')).to.include('@example.com'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.expect([200]).to.include(pm.response.code); });",
                  "pm.test('health ok', function () { pm.expect(pm.response.json().status).to.eql('ok'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Swagger OpenAPI YAML",
